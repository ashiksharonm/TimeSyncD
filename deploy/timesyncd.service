[Unit]
Description=TimeSyncD time-synchronisation server
After=network.target

[Service]
ExecStart=/usr/local/bin/timesyncd --config /etc/timesyncd/timesyncd.conf
Restart=on-failure
RestartSec=2
# SIGTERM triggers a graceful drain (drain_ms in the config); give it room.
TimeoutStopSec=10
LimitNOFILE=1048576
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
